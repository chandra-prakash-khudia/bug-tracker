pipeline {
    agent any

    stages {
        stage('Execute Unit Tests') {
            parallel {
                stage('Unit Tests - Backend') {
                    agent {
                        docker {
                            image 'snakee/golang-junit:1.21'
                            reuseNode true
                        }
                    }
                    environment {
                        HOME = "${WORKSPACE}"
                        GOCACHE = "${WORKSPACE}/.cache/go-build"
                        GOMODCACHE = "${WORKSPACE}/.cache/go-mod"
                        GOTMPDIR = "${WORKSPACE}/.tmp"
                    }
                    steps {
                        sh 'mkdir -p "$GOCACHE" "$GOMODCACHE" "$GOTMPDIR"'
                        dir('bugtracker-backend') {
                            sh '''
                                set -e
                                go test -v ./... 2>&1 | go-junit-report > test-results.xml
                                go test -coverprofile=coverage.out -covermode=atomic ./...
                                go tool cover -html=coverage.out -o coverage.html
                                mkdir -p reports
                                mv coverage.html reports/
                            '''
                        }
                    }
                    post {
                        always {
                            junit 'bugtracker-backend/test-results.xml'
                            publishHTML target: [
                                allowMissing: false,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: "${env.WORKSPACE}/bugtracker-backend/reports",
                                reportFiles: 'coverage.html',
                                reportName: 'Backend Coverage Report'
                            ]
                        }
                    }
                }

                stage('Unit Tests - Frontend') {
                    agent {
                        docker {
                            image 'node:20-alpine'
                            reuseNode true
                        }
                    }
                    steps {
                        dir('bugtracker-frontend') {
                            sh '''
                                set -e
                                npm ci
                                npm test
                                mkdir -p reports
                                cp -r coverage/. reports/
                            '''
                        }
                    }
                    post {
                        always {
                            junit 'bugtracker-frontend/test-results.xml'
                            publishHTML target: [
                                allowMissing: false,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: "${env.WORKSPACE}/bugtracker-frontend/reports",
                                reportFiles: 'index.html',
                                reportName: 'Frontend Coverage Report'
                            ]
                        }
                    }
                }
            }
        }

        stage('Launch Application') {
            agent {
                docker {
                    image 'docker:27.5.1'
                    reuseNode true
                    args '-v /var/run/docker.sock:/var/run/docker.sock -u 0'
                }
            }
            steps {
                sh 'docker compose up --build -d'
            }
        }

        stage('API Test') {
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.50.0-jammy'
                    reuseNode true
                    args '-u 0 --network=host'
                }
            }
            steps {
                dir('tests-api') {
                    sh '''
                        set -e
                        npx wait-port http://localhost:8080/api/health -t 30000
                        npm ci
                        npx playwright test
                        mkdir -p playwright-reports
                        cp -r playwright-report/. playwright-reports/ 2>/dev/null || true
                    '''
                }
            }
            post {
                always {
                    junit 'tests-api/test-results/results.xml'
                    publishHTML target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: "${env.WORKSPACE}/tests-api/playwright-reports",
                        reportFiles: 'index.html',
                        reportName: 'Playwright API Test Report'
                    ]
                }
            }
        }
        stage('E2E Tests'){
            agent{
                docker{
                    image 'mcr.microsoft.com/playwright:v1.50.0-jammy'
                    reuseNode true
                    args '-u 0 --network=host'
                }
            }
            steps{
                dir('tests-e2e'){
                    sh '''
                        set -e
                        npx wait-port http://localhost:3000 -t 30000
                        npm ci
                        set +e
                        npx playwright test
                        test_status=$?
                        set -e
                        mkdir -p playwright-reports
                        cp -r playwright-report/. playwright-reports/ 2>/dev/null || true
                        exit $test_status
                    '''
                }
            }
            post{
                always{
                    junit 'tests-e2e/test-results/results.xml'
                    publishHTML target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: "${env.WORKSPACE}/tests-e2e/playwright-reports",
                        reportFiles: 'index.html',
                        reportName: 'Playwright E2E Test Report'
                    ]

                }
            }
        }
    }

    post {
        always {
            deleteDir()
        }
    }
}
